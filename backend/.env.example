# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env a GitHub.

# Conexión a PostgreSQL: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tura_limpia"

# Pon "true" cuando la base de datos esté en la nube (Render, Neon, Supabase...)
DATABASE_SSL="false"

# Puerto del backend
PORT=4000

# Clave para firmar los tokens. En producción usa una cadena larga y aleatoria.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"

# Duración de la sesión (formato de jsonwebtoken: 8h, 30m, 1d...)
JWT_EXPIRES_IN="8h"

# URL(s) del frontend autorizadas para llamar al backend (separadas por coma)
CORS_ORIGIN="http://localhost:5173"

# Datos del administrador inicial (los usan `npm run create-admin` y el seed)
ADMIN_NOMBRE="Administrador Tura Limpia"
ADMIN_EMAIL="admin@turalimpia.co"
ADMIN_PASSWORD="Admin123*"
